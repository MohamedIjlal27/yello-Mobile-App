{
  "expo": {
    "name": "YeLO",
    "slug": "yello",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "YeLo",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/yello_logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "icon": "./assets/images/yello_logo.png",
    "androidStatusBar": {
      "backgroundColor": "#000000",
      "translucent": true,
      "barStyle": "light-content"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "splash": {
        "image": "./assets/images/yello_logo.png",
        "resizeMode": "contain",
        "backgroundColor": "#000000"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/yello_logo.png",
        "backgroundColor": "#000000"
      },
      "package": "com.mohamed_ijlal.YeLo",
      "splash": {
        "image": "./assets/images/yello_logo.png",
        "resizeMode": "contain",
        "backgroundColor": "#000000"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/yello_logo.png"
    },
    "plugins": [
      "expo-splash-screen",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "d8ead826-a747-4685-acde-28f6f8476c5f"
      }
    }
  }
}
